{
  "name": "crawlwise",
  "productName": "Crawlwise",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop website crawler for technical SEO audits.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
