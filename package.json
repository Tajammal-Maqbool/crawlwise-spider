    "electron": "^44.9.2",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@tanstack/react-virtual": "^3.14.21",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1"
